{
  "name": "happy-friends-kids",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25.0.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "node --test server/*.test.js",
    "test:e2e": "playwright test",
    "retention:purge": "node server/run-retention.js",
    "retention:test-purge": "node server/run-test-retention.js",
    "privacy:reapply-erasure": "node server/reapply-erasure-tombstones.js",
    "production:verify": "node server/verify-production-deployment.js",
    "preview": "vite preview",
    "start": "node server/index.js",
    "mobile:prepare": "node scripts/prepare-mobile-assets.js",
    "mobile:sync": "npm run build && npm run mobile:prepare && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@file-type/av": "0.2.0",
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "file-type": "22.0.1",
    "jsonwebtoken": "^9.0.2",
    "mp4box": "2.4.1",
    "multer": "^2.2.0",
    "music-metadata": "11.14.0",
    "pg": "^8.16.3",
    "phaser": "^3.90.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ts-ebml": "3.0.2",
    "vite": "6.4.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript": "^6.0.3"
  }
}
